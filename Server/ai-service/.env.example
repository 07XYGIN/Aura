# Qwen 3.7 Plus tuning
AURA_LLM_TEMPERATURE=0.7
AURA_LLM_TOP_P=0.85
AURA_LLM_ENABLE_THINKING=false
AURA_STRUCTURED_REPLY_TEMPERATURE=0.0
AURA_STRUCTURED_REPLY_TOP_P=0.2
AURA_MEMORY_JUDGE_TEMPERATURE=0.0
AURA_MEMORY_JUDGE_TOP_P=0.2
AURA_EMOTION_JUDGE_TEMPERATURE=0.0
AURA_EMOTION_JUDGE_TOP_P=0.2

# Amap API key. Fill both with the same value until env naming is unified.
amap_key=6f8407e0cb2fdafbf2bce16a18b32297
AMAP_KEY=6f8407e0cb2fdafbf2bce16a18b32297

# Uploads
AURA_UPLOAD_DIR=uploads

# Proactive scheduler
AURA_PROACTIVE_SCHEDULER_ENABLED=true
AURA_PROACTIVE_SCHEDULER_INTERVAL_SECONDS=600
AURA_PROACTIVE_SCHEDULER_LOOKAHEAD_HOURS=24

# SSE runtime
AURA_SSE_MAX_CONCURRENCY=16
AURA_SSE_QUEUE_SIZE=32

# Logging
AURA_LOG_LEVEL=INFO
AURA_LOG_VALUE_MAX_LENGTH=1000
AURA_SQL_RESULT_MAX_ROWS=50

# Memory tuning
MEMORY_RELEVANCE_THRESHOLD=0.55
LONG_MEMORY_RECALL_COOLDOWN_MINUTES=180
LONG_MEMORY_COOLDOWN_BYPASS_THRESHOLD=0.78
LONG_MEMORY_COOLDOWN_PENALTY=0.25
LONG_MEMORY_DEDUP_THRESHOLD=0.75
LONG_MEMORY_DEDUP_CANDIDATES=3
LONG_MEMORY_MERGE_THRESHOLD=0.85
LONG_MEMORY_MERGE_SCAN_LIMIT=300
MID_MEMORY_PROMOTION_RECALL_THRESHOLD=3

# Test-only switches
AURA_RUN_LIVE_MODEL_TESTS=0
AURA_TEST_MODEL=qwen3:8b
